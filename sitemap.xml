<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mithooos — sitemap.xml

  This covers the static, publicly-indexable marketing pages only.
  Product detail pages (pages/product.php?id=N) are database-driven
  and can't be enumerated in a hand-written static file — see the Future
  Production Configuration note below for how to generate a complete
  sitemap (including every product) once this is deployed with a real
  domain and database.

  NOTE: URLs below use a placeholder production domain. This file has no
  effect on localhost (nothing serves/consumes it there), but the domain
  must be corrected before this is actually useful in production — see
  robots.txt for the matching Sitemap: reference.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>https://mithooos.com/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://mithooos.com/pages/shop.html</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://mithooos.com/pages/about.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://mithooos.com/pages/contact.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
  <url>
    <loc>https://mithooos.com/pages/blog.html</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>

  <!--
    Future Production Configuration:

    Product pages should be generated dynamically rather than maintained by
    hand, since the catalog changes as an admin adds/removes products. Two
    common approaches for this stack:

    1. A small PHP script (e.g. backend/sitemap.php) that queries
       `SELECT slug, updated_at FROM products WHERE is_active = 1` and emits
       the <url> entries on the fly, served at /sitemap.xml via a rewrite
       rule.

    2. A scheduled build step (cron / CI) that regenerates this static file
       periodically by hitting GET /api/products with a high limit and
       writing the result out.

    Either way: point each product's <loc> at
    https://mithooos.com/pages/product.php?id={product_id}
    (or a cleaner /product/{slug} URL if a rewrite rule is added for that),
    and reference the resulting file from robots.txt's Sitemap: line.
  -->

</urlset>
